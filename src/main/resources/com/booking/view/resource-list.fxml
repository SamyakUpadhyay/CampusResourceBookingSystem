<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.booking.controller.ResourceListController"
            stylesheets="@styles.css"
            styleClass="dashboard-root"
            prefWidth="1040"
            prefHeight="680">

    <top>
        <VBox styleClass="dashboard-header" spacing="16">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label text="Campus Resources" styleClass="dashboard-title"/>
                    <Label text="Search and book study rooms, labs, and event spaces" styleClass="dashboard-subtitle"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="filter-bar">
                <VBox spacing="4">
                    <Label text="Search" styleClass="field-label"/>
                    <TextField fx:id="searchField"
                               promptText="Name, ID, or location"
                               styleClass="text-input"
                               prefWidth="220"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Type" styleClass="field-label"/>
                    <ComboBox fx:id="typeFilter" prefWidth="160" styleClass="combo-box"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Status" styleClass="field-label"/>
                    <ComboBox fx:id="availabilityFilter" prefWidth="160" styleClass="combo-box"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="dashboard-content">
            <TableView fx:id="resourceTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="90"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="140"/>
                    <TableColumn fx:id="locationColumn" text="Location" prefWidth="200"/>
                    <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="90"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="140"/>
                    <TableColumn fx:id="actionColumn" text="" prefWidth="130" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
